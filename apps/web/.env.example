# Leave empty in local development so Vite proxies /api to http://127.0.0.1:8080.
VITE_API_BASE_URL=

# Development convenience only. Production workspace selection comes from authenticated membership.
VITE_DEFAULT_WORKSPACE_ID=

# Never commit a real CSRF token. This is optional and only useful for local manual testing.
VITE_DEV_CSRF_TOKEN=
