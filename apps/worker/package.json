{
  "name": "@tehkarta/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "once": "WORKER_MODE=once tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@tehkarta/ai": "workspace:*",
    "@tehkarta/application": "workspace:*",
    "@tehkarta/database": "workspace:*",
    "@tehkarta/ports": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
