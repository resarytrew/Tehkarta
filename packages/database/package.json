{
  "name": "@tehkarta/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "echo 'Database integration tests run in CI smoke job'",
    "migrate": "tsx src/migrate.ts",
    "smoke": "tsx src/smoke.ts && tsx src/proposal-dismiss-smoke.ts && tsx src/proposal-smoke.ts && tsx src/auth-smoke.ts && tsx src/knowledge-space-smoke.ts",
    "bootstrap-dev": "tsx src/bootstrap-dev.ts"
  },
  "dependencies": {
    "@tehkarta/application": "workspace:*",
    "@tehkarta/domain": "workspace:*",
    "@tehkarta/identity": "workspace:*",
    "@tehkarta/ports": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
