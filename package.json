{
  "name": "tehkarta",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter @tehkarta/api --filter @tehkarta/web dev",
    "worker:dev": "pnpm build:packages && pnpm --filter @tehkarta/worker dev",
    "worker:once": "pnpm build:packages && pnpm --filter @tehkarta/worker once",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e:critical": "pnpm build:packages && pnpm --filter @tehkarta/api build && pnpm --filter @tehkarta/api test",
    "db:migrate": "pnpm --filter @tehkarta/database migrate",
    "db:smoke": "pnpm --filter @tehkarta/database smoke",
    "db:bootstrap-dev": "pnpm --filter @tehkarta/database bootstrap-dev"
  },
  "engines": {
    "node": ">=22"
  }
}
