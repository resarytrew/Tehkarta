# Local development only. Never commit real secrets.
DATABASE_URL=postgres://tehkarta:tehkarta@localhost:5432/tehkarta
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=tehkarta-api
# Modes: disable | require | verify-full. For Yandex Managed PostgreSQL with
# certificate verification, mount/copy the Yandex CA and set DB_SSL_CA_PATH.
DB_SSL=disable
DB_SSL_CA_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=43200
# Required in production; source it from Lockbox. Used only as an HMAC key for
# pseudonymizing client IPs and login-principal throttle identifiers.
AUTH_IP_HASH_KEY=
TRUST_PROXY=false

# AI provider secrets are read from Lockbox in production.
OPENROUTER_API_KEY=
YANDEX_AI_API_KEY=
