# Local development only. Never commit real secrets.
DATABASE_URL=postgres://tehkarta:tehkarta@localhost:5432/tehkarta
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=tehkarta-api
# Local postgres runs without TLS. Production Yandex Managed PostgreSQL uses TLS.
DB_SSL=disable

# Future adapters are read from Lockbox in production.
OPENROUTER_API_KEY=
YANDEX_AI_API_KEY=
