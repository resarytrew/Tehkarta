# Local development only. Never commit real secrets.
DATABASE_URL=postgres://tehkarta:tehkarta@localhost:5432/tehkarta
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=tehkarta-api
# Modes: disable | require | verify-full. For Yandex Managed PostgreSQL with
# certificate verification, mount/copy the Yandex CA and set DB_SSL_CA_PATH.
DB_SSL=disable
DB_SSL_CA_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=43200
# Required in production; source it from Lockbox. Used only as an HMAC key for
# pseudonymizing client IPs and login-principal throttle identifiers.
AUTH_IP_HASH_KEY=
TRUST_PROXY=false

# Worker runtime. `poll` keeps claiming durable PostgreSQL jobs; `once` claims
# at most one job and exits, which is useful for schedulers and diagnostics.
WORKER_MODE=poll
WORKER_ID=
WORKER_POLL_INTERVAL_MS=1500
WORKER_HEALTH_PORT=8080

# AI routing is explicit per task. There is intentionally no silent provider
# fallback: changing provider/model is a versioned routing-policy decision.
AI_ROUTING_POLICY_VERSION=routing-v2
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=2000
AI_VARIANTS_PROVIDER=yandex
AI_VARIANTS_MODEL=gpt://<folder-id>/<model-id>/latest
AI_REFORMULATE_PROVIDER=openrouter
AI_REFORMULATE_MODEL=<provider/model>

# Yandex AI Studio OpenAI-compatible endpoint. The API key must come from
# Lockbox/runtime injection in production.
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_API_KEY=

# OpenRouter OpenAI-compatible endpoint. Optional attribution headers do not
# contain secrets.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Tehkarta
