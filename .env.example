# Local development only. Never commit real secrets.
DATABASE_URL=postgres://tehkarta:tehkarta@localhost:5432/tehkarta
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000
DB_APPLICATION_NAME=tehkarta-api
# Modes: disable | require | verify-full. For Yandex Managed PostgreSQL with
# certificate verification, mount/copy the Yandex CA and set DB_SSL_CA_PATH.
DB_SSL=disable
DB_SSL_CA_PATH=

CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=43200
# Required in production; source it from Lockbox. Used only as an HMAC key for
# pseudonymizing client IPs and login-principal throttle identifiers.
AUTH_IP_HASH_KEY=
TRUST_PROXY=false

# Worker runtime. `poll` keeps claiming durable PostgreSQL jobs; `once` claims
# at most one job and exits, which is useful for schedulers and diagnostics.
WORKER_MODE=poll
WORKER_ID=
WORKER_POLL_INTERVAL_MS=1500
WORKER_HEALTH_PORT=8080

# Provider-neutral worker configuration. In production AI_API_KEY must come from
# Lockbox/environment injection and must never be committed or sent to the web app.
AI_PROVIDER_NAME=openai-compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ROUTING_POLICY_VERSION=routing-v1
AI_TIMEOUT_MS=90000
AI_MAX_TOKENS=2000

# Reserved provider-specific secrets for the richer P2.6 routing adapters.
OPENROUTER_API_KEY=
YANDEX_AI_API_KEY=
